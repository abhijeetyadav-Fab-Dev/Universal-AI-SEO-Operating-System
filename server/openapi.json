{
  "openapi": "3.0.3",
  "info": {
    "title": "OmniSEO OS Universal API",
    "version": "1.0.0",
    "description": "Enterprise-grade autonomous SEO operating system API providing multi-page crawling, live Core Web Vitals, backlink intelligence, GEO/AEO AI search readiness, and generative SEO strategic copilot.",
    "contact": {
      "name": "OmniSEO OS Engineering Team",
      "url": "https://universal-ai-seo-operating-system.onrender.com"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Active OmniSEO OS Instance"
    }
  ],
  "components": {
    "securitySchemes": {
      "GooglePsiApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-psi-key",
        "description": "Google PageSpeed Insights API Key"
      },
      "OpenRouterApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-openrouter-key",
        "description": "OpenRouter API Key for DeepSeek, Llama 3.3, and free open models"
      },
      "NvidiaNimApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-nvidia-key",
        "description": "NVIDIA NIM API Key for Llama 3.3, Nemotron, and DeepSeek-R1"
      },
      "GeminiApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-gemini-key",
        "description": "Google Gemini 2.0/1.5 Flash API Key"
      },
      "OpenAiApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-openai-key",
        "description": "OpenAI GPT-4o-mini API Key"
      },
      "DataForSeoLogin": {
        "type": "apiKey",
        "in": "header",
        "name": "x-dataforseo-login",
        "description": "DataForSEO API Login ID"
      },
      "DataForSeoPassword": {
        "type": "apiKey",
        "in": "header",
        "name": "x-dataforseo-password",
        "description": "DataForSEO API Password / Token"
      },
      "GoogleSearchConsoleOAuth": {
        "type": "oauth2",
        "description": "Google OAuth 2.0 Access Token with webmasters.readonly scope",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://accounts.google.com/o/oauth2/v2/auth",
            "tokenUrl": "https://oauth2.googleapis.com/token",
            "scopes": {
              "https://www.googleapis.com/auth/webmasters.readonly": "View Google Search Console data for verified sites"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/plan": {
      "post": {
        "summary": "Plan Orchestrated Multi-Agent Execution",
        "description": "Parses natural language queries and returns a structured multi-agent execution plan with required disciplines and entity detection.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": { "type": "string", "example": "Audit https://example.com and check Core Web Vitals" },
                  "url": { "type": "string", "example": "https://example.com" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Execution plan generated successfully" },
          "400": { "description": "Invalid input query or URL" }
        }
      }
    },
    "/api/v1/execute": {
      "post": {
        "summary": "Execute Unified Multi-Agent Audit",
        "description": "Runs parallel specialized agents (Technical DOM, PageSpeed, Ahrefs, GEO/AEO, Trends, SERP) and returns a unified canonical audit model with line-level code fixes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": { "type": "string" },
                  "plan": { "type": "object" },
                  "url": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Audit executed with complete canonical model and line-level recommendations" },
          "400": { "description": "Target query or URL required" }
        }
      }
    },
    "/api/v1/audit": {
      "post": {
        "summary": "Multi-Page Deep Site Crawler",
        "description": "Recursively crawls internal site architecture up to 20 pages with line-level code patch generation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url"],
                "properties": {
                  "url": { "type": "string", "example": "https://example.com" },
                  "maxPages": { "type": "integer", "default": 15, "maximum": 20 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Crawled internal page tree with identified issues" }
        }
      }
    },
    "/api/v1/backlinks": {
      "post": {
        "summary": "Backlink Intelligence & Disavow Generator",
        "description": "Analyzes referring domains, domain authority, anchor text diversity, toxic link risk, and generates Google Disavow rules.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": { "type": "string", "example": "https://example.com" },
                  "domain": { "type": "string", "example": "example.com" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Backlink profile and disavow rules payload" }
        }
      }
    },
    "/api/v1/ai-prompt": {
      "post": {
        "summary": "AI SEO Strategy Copilot",
        "description": "Answers strategic SEO queries using live Google Gemini (2.5/1.5 Flash) or OpenAI (gpt-4o-mini) grounded in real crawled DOM context.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["prompt"],
                "properties": {
                  "prompt": { "type": "string", "example": "Generate high-CTR meta tags and schema recommendations" },
                  "url": { "type": "string", "example": "https://example.com" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Generative AI strategic advice" }
        }
      }
    },
    "/api/v1/domain": {
      "post": {
        "summary": "Domain Overview & Benchmark",
        "description": "Returns domain rating, SSL status, network latency, and peer competitor benchmarks.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url"],
                "properties": {
                  "url": { "type": "string", "example": "https://example.com" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Domain intelligence metrics" }
        }
      }
    },
    "/api/v1/competitor-gap": {
      "post": {
        "summary": "Competitor Authority & Keyword Gap Studio",
        "description": "Discovers untapped keywords, DA deficits, and link gap opportunities with estimated INR CPC.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["targetUrl"],
                "properties": {
                  "targetUrl": { "type": "string", "example": "https://example.com" },
                  "competitorDomain": { "type": "string", "example": "competitor.com" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Comparative competitor gap payload" }
        }
      }
    },
    "/api/v1/scrape": {
      "post": {
        "summary": "Universal Web Scraper Studio",
        "description": "Transforms live web pages into clean LLM-optimized Markdown or structured JSON metadata.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url"],
                "properties": {
                  "url": { "type": "string", "example": "https://example.com" },
                  "mode": { "type": "string", "enum": ["markdown", "metadata", "selector", "html"], "default": "markdown" },
                  "selector": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Extracted content and statistics" }
        }
      }
    },
    "/api/v1/robots-sitemap": {
      "get": {
        "summary": "Robots.txt & XML Sitemap Explorer",
        "description": "Probes server root for robots.txt, evaluates AI bot permissions (GPTBot, ClaudeBot, PerplexityBot), and parses declared XML sitemaps.",
        "parameters": [
          { "name": "url", "in": "query", "required": true, "schema": { "type": "string" }, "example": "https://example.com" }
        ],
        "responses": {
          "200": { "description": "Robots.txt directives and parsed sitemap URLs" }
        }
      }
    },
    "/api/v1/head-eeat": {
      "post": {
        "summary": "HTML <head> & E-E-A-T Quality Signals",
        "description": "Comprehensive <head> tag linter and Google Search Quality Rater E-E-A-T trust signals evaluation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url"],
                "properties": {
                  "url": { "type": "string", "example": "https://example.com" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Head completeness and E-E-A-T quality audit results" }
        }
      }
    },
    "/api/v1/open-intel": {
      "get": {
        "summary": "Universal Open-API Intelligence Lookup",
        "description": "Aggregates 7 zero-auth public endpoints in parallel: ICANN RDAP registry, Google DoH DNS, Wikipedia backlink citations, Hacker News discussions, Wikidata Knowledge Graph QID, Wikimedia Pageviews, and Datamuse Semantic LSI keywords.",
        "parameters": [
          { "name": "domain", "in": "query", "required": true, "schema": { "type": "string" }, "example": "wikipedia.org" }
        ],
        "responses": {
          "200": { "description": "Consolidated open-web intelligence payload" },
          "400": { "description": "Invalid domain or target parameter" }
        }
      },
      "post": {
        "summary": "Universal Open-API Intelligence Lookup (POST)",
        "description": "Aggregates 7 zero-auth public endpoints in parallel via JSON request body.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["domain"],
                "properties": {
                  "domain": { "type": "string", "example": "wikipedia.org" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Consolidated open-web intelligence payload" },
          "400": { "description": "Invalid domain or target parameter" }
        }
      }
    },
    "/api/auth/gsc/url": {
      "get": {
        "summary": "Generate Google Search Console OAuth 2.0 Consent URL",
        "description": "Returns Google consent URL requesting webmasters.readonly permissions.",
        "responses": {
          "200": { "description": "Consent URL generated successfully" }
        }
      }
    },
    "/api/auth/gsc/token": {
      "post": {
        "summary": "Exchange Authorization Code for Access & Refresh Tokens",
        "description": "Exchanges one-time OAuth code for persistent tokens with mock fallback mode.",
        "responses": {
          "200": { "description": "Tokens exchanged successfully" }
        }
      }
    },
    "/api/auth/gsc/refresh": {
      "post": {
        "summary": "Refresh Expired GSC Access Token",
        "description": "Refreshes expired OAuth access token using refresh_token.",
        "responses": {
          "200": { "description": "Token refreshed successfully" }
        }
      }
    },
    "/api/gsc/sites": {
      "get": {
        "summary": "List Verified Google Search Console Properties",
        "description": "Retrieves verified domains, URL prefixes, and user permission levels.",
        "responses": {
          "200": { "description": "Verified properties listed successfully" }
        }
      }
    },
    "/api/gsc/query": {
      "post": {
        "summary": "Query Google Search Console Search Analytics",
        "description": "Queries Search Console Analytics API and returns formatted queries, pages, clicks, impressions, CTR, and average position.",
        "responses": {
          "200": { "description": "Search analytics data returned successfully" }
        }
      }
    },
    "/api/v1/settings": {
      "get": {
        "summary": "Get Configured API Keys Status",
        "description": "Returns masked configuration status for Google PSI, Gemini, OpenAI, and DataForSEO.",
        "responses": {
          "200": { "description": "Status of configured credentials" }
        }
      }
    },
    "/api/v1/provenance": {
      "get": {
        "summary": "Data Integrity and Provenance Registry",
        "description": "Returns transparent 4-state data status (measured, heuristic, simulated, unavailable) and active provider catalog for every module.",
        "responses": {
          "200": { "description": "Live provenance mapping" }
        }
      }
    },
    "/api/v1/settings/save": {
      "post": {
        "summary": "Save API Settings & Provider Configuration",
        "description": "Securely updates in-memory API credentials and model preferences for OpenRouter, NVIDIA NIM, Google Gemini, OpenAI, Google PSI, and Google Search Console.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object" }
            }
          }
        },
        "responses": {
          "200": { "description": "Settings updated successfully" }
        }
      }
    },
    "/api/v1/settings/test": {
      "post": {
        "summary": "Test Provider API Connection",
        "description": "Performs an active ping/probe to verify validity of API credentials for psi, openrouter, nvidia, gemini, openai, or gsc.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "service": { "type": "string", "enum": ["psi", "openrouter", "nvidia", "gemini", "openai", "gsc"] },
                  "apiKey": { "type": "string" },
                  "model": { "type": "string" }
                },
                "required": ["service"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Provider connection successful" },
          "400": { "description": "Provider connection failed or invalid credentials" }
        }
      }
    },
    "/api/v1/guardrail/helpful-content": {
      "get": {
        "summary": "Google Helpful Content & E-E-A-T Guardrail Audit",
        "description": "Audits a live target webpage against Google Search Central Helpful Content System and E-E-A-T guidelines (Who, How, Why, E-E-A-T scores, anti-patterns, 8-question self-assessment matrix).",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "example": "https://example.com" }
          }
        ],
        "responses": {
          "200": { "description": "Helpful content and E-E-A-T evaluation returned" },
          "400": { "description": "Missing or SSRF-restricted target URL" }
        }
      }
    },
    "/api/v1/guardrail/helpful-content/evaluate": {
      "post": {
        "summary": "Direct Pre-Publish Content Helpfulness Evaluation",
        "description": "Evaluates draft HTML or Markdown text directly before publishing to verify compliance with Google People-First guidelines.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": { "type": "string", "example": "https://example.com/draft" },
                  "html": { "type": "string" },
                  "content": { "type": "string" },
                  "title": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Guardrail self-assessment results" },
          "400": { "description": "Missing required content payload" }
        }
      }
    },
    "/api/v1/audit/eeat": {
      "get": {
        "summary": "Comprehensive <head> & E-E-A-T Technical Audit",
        "description": "Performs in-depth audit of document head completeness, E-E-A-T signals, content readability metrics, and helpful content guardrail.",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "example": "https://example.com" }
          }
        ],
        "responses": {
          "200": { "description": "Complete head and E-E-A-T audit returned" },
          "400": { "description": "Missing or restricted URL" }
        }
      }
    },
    "/api/v1/storage/snapshot": {
      "post": {
        "summary": "Save Audit Snapshot to Persistent Storage",
        "description": "Stores complete audit results into embedded persistent database with timestamp, domain key, and health metrics.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "domain": { "type": "string", "example": "example.com" },
                  "url": { "type": "string", "example": "https://example.com" },
                  "auditData": { "type": "object" }
                },
                "required": ["domain", "auditData"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Audit snapshot persisted" }
        }
      }
    },
    "/api/v1/storage/history/{domain}": {
      "get": {
        "summary": "Retrieve Historical Audit Snapshots for Domain",
        "description": "Returns time-series audit snapshots to track SEO health progression over time.",
        "parameters": [
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "example.com" }
          }
        ],
        "responses": {
          "200": { "description": "Historical snapshots array" }
        }
      }
    },
    "/api/v1/storage/projects": {
      "get": {
        "summary": "List Monitored Projects & Health Trends",
        "description": "Returns all saved domains, snapshot counts, and latest health scores.",
        "responses": {
          "200": { "description": "Projects list returned" }
        }
      }
    },
    "/api/v1/storage/snapshot/{snapshotId}": {
      "get": {
        "summary": "Get Audit Snapshot by ID",
        "parameters": [
          { "name": "snapshotId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Snapshot data returned" },
          "404": { "description": "Snapshot not found" }
        }
      },
      "delete": {
        "summary": "Delete Audit Snapshot by ID",
        "parameters": [
          { "name": "snapshotId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Snapshot deleted" }
        }
      }
    },
    "/api/v1/storage/compare": {
      "post": {
        "summary": "Compare Two Snapshots for Progress Delta",
        "description": "Calculates health score differences, new issues, and resolved issues between two audit runs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "baseSnapshotId": { "type": "string" },
                  "targetSnapshotId": { "type": "string" }
                },
                "required": ["baseSnapshotId", "targetSnapshotId"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Comparison delta metrics returned" }
        }
      }
    },
    "/api/v1/export/report": {
      "post": {
        "summary": "Generate White-Label Executive HTML/PDF Report",
        "description": "Generates a clean, printable white-label executive audit report complete with cover page, executive scorecard, code diffs, and remediation steps.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "auditData": { "type": "object" },
                  "brandName": { "type": "string", "example": "OmniSEO OS" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Printable HTML report document" }
        }
      }
    },
    "/api/v1/export/csv": {
      "post": {
        "summary": "Bulk RFC-4180 CSV Data Export",
        "description": "Exports audit data into spreadsheets for pages, missing alt images, audit issues, or backlinks.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "enum": ["pages", "alts", "issues", "backlinks"] },
                  "auditData": { "type": "object" }
                },
                "required": ["type", "auditData"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "RFC-4180 compliant CSV stream" }
        }
      }
    },
    "/api/v1/indexnow": {
      "post": {
        "summary": "Submit URLs via IndexNow Protocol",
        "description": "Directly pings Bing and Yandex with newly crawled or modified URLs for instant indexing.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "host": { "type": "string", "example": "example.com" },
                  "urlList": { "type": "array", "items": { "type": "string" } },
                  "key": { "type": "string" }
                },
                "required": ["host", "urlList"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "IndexNow submission receipt" }
        }
      }
    },
    "/api/v1/indexnow/key": {
      "get": {
        "summary": "Retrieve IndexNow Verification Key",
        "responses": {
          "200": { "description": "Key string and instructions" }
        }
      }
    },
    "/api/v1/sitemap/orphans": {
      "post": {
        "summary": "Detect Orphan Pages",
        "description": "Cross-references XML sitemap URL entries against internal crawler links to identify unlinked orphan pages and unindexed sitemap URLs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sitemapUrls": { "type": "array", "items": { "type": "string" } },
                  "crawledUrls": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["sitemapUrls", "crawledUrls"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Orphan pages report" }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "summary": "Service Health Check",
        "description": "Returns operational status and active capability catalog.",
        "responses": {
          "200": { "description": "Service status" }
        }
      }
    }
  }
}
