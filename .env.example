# OmniSEO OS — Environment Configuration
# Copy this file to .env and provide your API keys for live integrations.

# Web Server Port
PORT=4000

# Google PageSpeed Insights API Key (Free tier: 25,000 queries/day)
# Get a free key at: https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PSI_API_KEY=

# OpenRouter API Key (Recommended: DeepSeek, Llama 3.3, Free Models)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# NVIDIA NIM API Key (1,000 Free Credits: Llama 3.3, Nemotron, DeepSeek-R1)
# Get a key at: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Google Gemini API Key (Free tier on Google AI Studio)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: OpenAI API Key (gpt-4o-mini)
OPENAI_API_KEY=

# Optional: DataForSEO Live Backlinks API Credentials (pay-per-use, ~$0.02/call)
# Sign up at: https://dataforseo.com/
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google Search Console (GSC) OAuth 2.0 Credentials
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/api/auth/gsc/callback
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=http://localhost:4000/api/auth/gsc/callback
